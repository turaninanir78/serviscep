# PostgreSQL
# Not published to the host - only reachable from other containers on the
# compose network (backend connects via postgres:5432).
POSTGRES_USER=serviscep
POSTGRES_PASSWORD=change_me
POSTGRES_DB=serviscep

# Backend (FastAPI)
BACKEND_PORT=8000

# Frontend (Next.js)
FRONTEND_PORT=3000
# Must be reachable from the browser (not the Docker network), since the
# frontend calls this URL client-side and it is inlined at build time.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# PostgreSQL
# Not published to the host - only reachable from other containers on the
# compose network (backend connects via postgres:5432).
POSTGRES_USER=serviscep
POSTGRES_PASSWORD=change_me
POSTGRES_DB=serviscep

# Backend (FastAPI)
BACKEND_PORT=8000
# Generate your own for real use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=aec67b945d3243b0838d889707860916cc5c796ccf6773e704b6729d3c42a19b
# "production" olarak ayarlarsaniz, uygulama COOKIE_SECURE=true DEGILSE
# baslamayi reddeder (bkz. app/security.py::_validate_cookie_security) -
# boylece bir production dagitiminin yanlislikla HTTPS zorunlulugu olmayan
# bir oturum cookie'siyle acilmasi engellenir. Dev/test'te degistirmeyin.
ENVIRONMENT=development
# Auth cookie'sinin Secure bayragi. Dev'de (http://localhost) FALSE olmali -
# Secure=true olan bir cookie'yi tarayici HTTPS disinda hic kaydetmez, bu da
# login'in basarili gorunup sonraki her istegin sessizce 401 donmesine yol
# acar. Prod'da (HTTPS arkasinda) true yapin - ENVIRONMENT=production iken
# false birakirsaniz uygulama hic baslamaz.
COOKIE_SECURE=false
# Login/register endpoint'lerinde IP bazli rate limiting (bkz.
# app/rate_limit.py). Bos birakilirsa ENVIRONMENT=production'da otomatik
# acik, aksi halde kapali (dev/test ortaminda ayni container'a karsi
# calisan tum testler ayni loopback IP'yi paylastigi icin kapali olmali -
# aksi halde birbirlerini kirarlar). Gercek zorlanmayi test etmek icin
# tests/test_auth_rate_limit.py'nin basindaki talimata bakin.
RATE_LIMIT_ENABLED=
# Bos birakilirsa varsayilanlar kullanilir: login icin "5/minute", register
# icin "10/hour". Sadece farkli bir deger denemek isterseniz doldurun.
AUTH_LOGIN_RATE_LIMIT=
AUTH_REGISTER_RATE_LIMIT=
# Telefonla kayit / e-posta ekleme icin OTP kodu isteme-dogrulama limitleri
# (bkz. app/rate_limit.py). Bos birakilirsa: istek icin "5/hour", dogrulama
# icin "10/minute".
OTP_REQUEST_RATE_LIMIT=
OTP_VERIFY_RATE_LIMIT=

# Musteri kisisel verisini (isim, telefon - bkz. app/db_types.py::EncryptedString)
# DB'de sifreli saklamak icin kullanilir. WHATSAPP_TOKEN_ENCRYPTION_KEY'den
# BILEREK AYRI bir anahtar (farkli hassasiyet siniflari, anahtar ayrimi
# ilkesi - bkz. app/crypto.py). Ayni komutla uretin, AYRI bir deger olsun.
PII_ENCRYPTION_KEY=  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" ile uretin

# WhatsApp Cloud API (Faz 1.5) - henuz gercek bir Meta hesabi yok, bu
# degerler simule edilmis webhook testleri icin kullaniliyor.
# Access token'lari DB'de sifreli saklamak icin kullanilir.
WHATSAPP_TOKEN_ENCRYPTION_KEY=  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" ile uretin
# Meta App Dashboard > Settings > Basic > App Secret (webhook imza dogrulama)
WHATSAPP_APP_SECRET=dev-app-secret-change-me
# Webhook kurulumu sirasinda Meta'ya siz girersiniz, kendi sectiginiz bir deger
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev-verify-token-change-me

# Frontend (Next.js)
FRONTEND_PORT=3000
# Must be reachable from the browser (not the Docker network), since the
# frontend calls this URL client-side and it is inlined at build time.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

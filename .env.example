# PostgreSQL
# Not published to the host - only reachable from other containers on the
# compose network (backend connects via postgres:5432).
POSTGRES_USER=serviscep
POSTGRES_PASSWORD=change_me
POSTGRES_DB=serviscep

# Backend (FastAPI)
BACKEND_PORT=8000
# Generate your own for real use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=aec67b945d3243b0838d889707860916cc5c796ccf6773e704b6729d3c42a19b
# Auth cookie'sinin Secure bayragi. Dev'de (http://localhost) FALSE olmali -
# Secure=true olan bir cookie'yi tarayici HTTPS disinda hic kaydetmez, bu da
# login'in basarili gorunup sonraki her istegin sessizce 401 donmesine yol
# acar. Prod'da (HTTPS arkasinda) true yapin.
COOKIE_SECURE=false

# WhatsApp Cloud API (Faz 1.5) - henuz gercek bir Meta hesabi yok, bu
# degerler simule edilmis webhook testleri icin kullaniliyor.
# Access token'lari DB'de sifreli saklamak icin kullanilir.
WHATSAPP_TOKEN_ENCRYPTION_KEY=  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" ile uretin
# Meta App Dashboard > Settings > Basic > App Secret (webhook imza dogrulama)
WHATSAPP_APP_SECRET=dev-app-secret-change-me
# Webhook kurulumu sirasinda Meta'ya siz girersiniz, kendi sectiginiz bir deger
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev-verify-token-change-me

# Frontend (Next.js)
FRONTEND_PORT=3000
# Must be reachable from the browser (not the Docker network), since the
# frontend calls this URL client-side and it is inlined at build time.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
